#!/data/data/com.termux/files/usr/bin/python
"""text-pdf OUT.pdf TEXT...: Markdown or text to PDF, also accepts stdin."""
import subprocess
import sys
from pathlib import Path

def main(argv):
    if len(argv) < 2:
        print('usage: text-pdf OUT.pdf TEXT... (or pipe Markdown in)', file=sys.stderr)
        return 2
    if not argv[1].lower().endswith('.pdf'):
        print('OUT must end in .pdf', file=sys.stderr)
        return 2
    text = ' '.join(argv[2:]) if len(argv) > 2 else sys.stdin.read()
    return subprocess.run([str(Path(__file__).resolve().parent / 'make-pdf'), argv[1]], input=text, text=True).returncode

if __name__ == '__main__':
    raise SystemExit(main(sys.argv))
