#!/data/data/com.termux/files/usr/bin/sh
# page-wait 'TEXT' [TIMEOUT_MS] : wait until TEXT is on the page (default 30000 ms).
here=$(dirname "$(readlink -f "$0")")
exec proot-distro login --work-dir "$PWD" debian -- env "HARNESS_STATE_DIR=${HARNESS_STATE_DIR:-}" "PAGE_TAB_FILE=${PAGE_TAB_FILE:-}" "CDP_PORT=${CDP_PORT:-9335}" node "$here/../debian/page.cjs" wait "$@"
