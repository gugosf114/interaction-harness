#!/data/data/com.termux/files/usr/bin/python
"""edit-exact FILE OLD NEW : replace OLD with NEW in FILE. It works only when OLD appears exactly once.

Exit 0: replaced. Exit 1: OLD not found, or found more than once (nothing is written).
Exit 2: wrong use, or the file cannot be read or written.
"""
import os
import sys
import tempfile


def main(argv):
    if len(argv) != 4:
        print('usage: edit-exact FILE OLD NEW', file=sys.stderr)
        return 2
    path, old, new = argv[1], argv[2], argv[3]
    if not old:
        print('OLD is empty.', file=sys.stderr)
        return 2
    if old == new:
        print('OLD and NEW are the same text.', file=sys.stderr)
        return 2
    try:
        with open(path, encoding='utf-8', newline='') as handle:
            text = handle.read()
    except (OSError, UnicodeDecodeError) as exc:
        print(f'Cannot read {path}: {exc.__class__.__name__}.', file=sys.stderr)
        return 2
    count = text.count(old)
    if count == 0:
        print(f'OLD was not found in {path}. Nothing was written.', file=sys.stderr)
        return 1
    if count > 1:
        print(f'OLD appears {count} times in {path}. It must appear exactly once. Nothing was written.', file=sys.stderr)
        return 1
    line = text[:text.index(old)].count('\n') + 1
    folder = os.path.dirname(os.path.abspath(path))
    try:
        mode = os.stat(path).st_mode & 0o7777
        fd, temp = tempfile.mkstemp(prefix='.edit-exact-', dir=folder)
        try:
            with os.fdopen(fd, 'w', encoding='utf-8', newline='') as handle:
                handle.write(text.replace(old, new))
            os.chmod(temp, mode)
            os.replace(temp, path)
        finally:
            if os.path.exists(temp):
                os.unlink(temp)
    except OSError as exc:
        print(f'Cannot write {path}: {exc.__class__.__name__}.', file=sys.stderr)
        return 2
    print(f'Replaced 1 occurrence in {path}, at line {line}.')
    return 0


if __name__ == '__main__':
    raise SystemExit(main(sys.argv))
