#!/data/data/com.termux/files/usr/bin/sh
# page-open URL [WAIT_MS] : open URL in a new tab of the signed-in phone Chrome; later page commands act on that tab.
here=$(dirname "$(readlink -f "$0")")
exec proot-distro login --work-dir "$PWD" debian -- env "HARNESS_STATE_DIR=${HARNESS_STATE_DIR:-}" "PAGE_TAB_FILE=${PAGE_TAB_FILE:-}" "CDP_PORT=${CDP_PORT:-9335}" node "$here/../debian/page.cjs" open "$@"
