#!/data/data/com.termux/files/usr/bin/python
"""skill : George's skill packs (folders with a SKILL.md), for the API lanes.

  skill list [GROUP]      every skill: name and one-line purpose (GROUP: see skill groups)
  skill show NAME [PART|--all]  the lane notes, then the skill's own instructions, in parts of 7,000 characters
  skill files NAME        the skill's scripts and reference files, with full paths and how to run each
  skill find WORDS        the skills that match the words, best first
  skill groups            where the skills live and how many each place holds

Paths are Debian-side paths (/root/...). Both sides see /data/data/com.termux/files/home and /sdcard the same way.
"""
import json
import os
import re
import sys
from pathlib import Path

ROOTFS = os.environ.get('SKILL_ROOTFS', '/data/data/com.termux/files/usr/var/lib/proot-distro/containers/debian/rootfs')
HOME = '/data/data/com.termux/files/home'
PART = 7000
# (group, folder, prefix for skills that sit outside a plugin). Order decides which copy wins a name.
DEFAULT_ROOTS = [
    ('claude', '/root/.claude/skills', ''),
    ('claude', '/root/.skills-kept', ''),
    ('claude-plugin', '/root/.claude/plugins/synced', ''),
    ('claude-plugin', '/root/.claude/plugins/cache', ''),
    ('codex', HOME + '/.codex/skills', 'codex:'),
    ('codex', '/root/.codex/skills', 'debian-codex:'),
    ('project', '/root/work-training/corpus/skill', 'training:'),
    ('library', '/usr/local/lib/node_modules/@brightdata/cli/node_modules/playwright-core/lib/tools/skills', 'brightdata-playwright:'),
    ('codex-plugin', HOME + '/.codex/plugins/cache', ''),
    ('project', HOME + '/plugins/george-shipping-studio', ''),
    ('project', '/root/wim-android/onboarding-plugin', ''),
    ('project', '/root/agent-bridge/tools/session-toolkit/job-apply', ''),
    ('project', HOME + '/llama.cpp/skills', 'llama.cpp:'),
    ('project', HOME + '/work/codex-termux-0.153.4-build/.codex/skills', 'codex-source:'),
    ('marketplace', '/root/.claude/plugins/marketplaces', ''),
