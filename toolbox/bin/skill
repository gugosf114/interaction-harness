def lane_notes(skill):
    text = skill['text'] + ' ' + skill['allowed']
    notes = []
    has_files = any(p.is_file() and p.name != 'SKILL.md' for p in skill['real_folder'].rglob('*')) if skill['kind'] == 'skill' else False
    if has_files:
        notes.append(f"The skill's folder is {skill['folder']}. A path in the text such as scripts/x.py means "
                     f"{skill['folder']}/scripts/x.py. List them: skill files {skill['name']}")
    if skill['plugin_dir'] and ('CLAUDE_PLUGIN_ROOT' in text or 'plugin root' in text.lower()):
        notes.append(f"CLAUDE_PLUGIN_ROOT is {skill['plugin_dir']}.")
    if not has_files and re.search(r'CLAUDE_SKILL_DIR|this skill.s (base )?directory|skill.s directory|relative to this skill', text):
        notes.append(f"The skill's directory is {skill['folder']}.")
    if re.search(r'\bpython3?\b|\bnode\b|\bnpm\b|\bpip\b|\bbash\b|\bBash\b|```(bash|sh|python|javascript|js)', text):
        notes.append("Commands in the text run in your execution_payload. Python, node, soffice, pandoc and the skill's "
                     "own scripts live on the Debian side: put deb in front, and use full paths, because a cd does not "
                     "carry to the next command. One job in one line: deb bash -c 'cd /sdcard/Download && python3 make.py'. "
                     "Write the script file first (card files), then run it. Put files George should get in /sdcard/Download.")
    if re.search(r'\bRead\b', text):
        notes.append("'Read' a text file: deb sed -n '1,120p' PATH. 'Read' an image or a PDF to look at it: look PATH, "
                     "and the picture arrives in your next turn.")
    if re.search(r'\bWrite\b|\bEdit\b|\bMultiEdit\b', text):
        notes.append("'Write' a new file: the set -C heredoc on card files. 'Edit': edit-exact FILE 'OLD' 'NEW'.")
    if re.search(r'WebSearch|WebFetch|web search|search the web|web_search|web_fetch|fetch the (page|url)', text, re.I):
        notes.append('Web search and page reading are your own provider tools in this client: search and read pages '
                     'directly. A page that needs George signed in: page-text URL (card phone-browser).')
    if re.search(r'image_gen|imagegen|image generation|generate images', text, re.I):
        notes.append('Image generation: the OpenAI lane has the image-generation API tool; generated files are saved '
                     'under the lane state/generated folder. The Anthropic lane has no native image-generation tool. '
                     'For an existing local picture use look PATH (card screen).')
    if re.search(r'\bAgent tool\b|\bTask tool\b|subagent|sub-agent|\bAgent\(|fan-out|in parallel|parallel agents|spawn', text, re.I):
        notes.append('Subagents: the lanes have none. Do each part yourself, one after another, in the loop. '
                     'One question to a second model: card models.')
    if 'AskUserQuestion' in text or re.search(r'\bask the user\b', text, re.I):
        notes.append('Asking George: there is no question tool. Ask in direct_answer with no command, only when the '
                     'job cannot go on without his answer.')
    if re.search(r'TodoWrite|TaskCreate|todo list', text, re.I):
        notes.append('There is no to-do tool: keep the step list in your answer.')
    if re.search(r'\bSkill tool\b|invoke the [`"]?[a-z-]+[`"]? skill|load the [`"]?[a-z:-]+[`"]? skill|/[a-z-]+:[a-z-]+', text):
        notes.append('Another skill named in the text: skill show NAME prints it.')
    if re.search(r'\bArtifact\b|artifact type|Docs connector|docs skill|slides skill', text):
        notes.append('This client has no Artifact tool, no Docs connector, no slide artifact type and no slides skill. '
                     'Where the text prefers one of those, use the skill\'s file route. A web page goes to '
                     '/sdcard/Download/NAME.html.')
    if '~~' in text:
        notes.append('Words such as ~~CRM or ~~chat name kinds of connectors. Mail, Calendar and Drive use card mail, card calendar and card drive; other unnamed connectors use files on '
                     'the phone, from the web, or from what George pastes.')
    if re.search(r'\bgh (pr|issue|api|repo)\b|GitHub', text):
        notes.append('gh and git are signed in as gugosf114 on the Termux side: card github.')
    for pattern, line in CONNECTORS:
        if re.search(pattern, text):
            notes.append(line)
    named_tools = sorted(set(re.findall(r'\bmcp__[A-Za-z0-9_]+', text)))
    known = ('claude_ai_Gmail', 'claude_ai_Google_Drive', 'claude_ai_Google_Calendar', 'plugin_brightdata')
    unknown = [name for name in named_tools if not any(key in name for key in known)]
    if unknown:
        notes.append('These named connector tools have no matching lane command: ' + ', '.join(unknown) + '.')
    have = []
    for pattern, label in INSTALLED:
        if label and re.search(pattern, text) and label not in have:
            have.append(label)
    if have:
        notes.append('Installed on the Debian side (checked 2026-11-11), so the skill\'s "preinstalled" holds: '
                     + ', '.join(have) + '. Node finds the npm packages from any folder.')
    for pattern, line in MISSING:
        if re.search(pattern, text):
            notes.append('Not on the lanes: ' + line)
    if skill['group'] == 'marketplace':
        notes.append("This plugin is in a downloaded catalog and is not installed in George's Claude Code. Its "
                     "instructions still read the same.")
    return notes


# ---- the verbs ---------------------------------------------------------------------------------------------
def cmd_list(skills, args):
    if len(args) > 1:
        return usage()
    chosen = [s for s in skills if not args or s['group'] == args[0]]
    if args and not chosen:
        print(f'No group named {args[0]}. Groups: ' + ', '.join(GROUP_WORDS), file=sys.stderr)
        return 1
    print(f'{len(chosen)} skills. Print one with: skill show NAME')
    for s in chosen:
        print(f"{s['name']:<44} {purpose(s['description']) or '(no description)'}")
    return 0


def cmd_groups(skills, args):
    if args:
        return usage()
    print(f'{len(skills)} skills in all.')
    for group, words in GROUP_WORDS.items():
        count = sum(1 for s in skills if s['group'] == group)
        if count:
            print(f'{group:<14} {count:>3}  {words}')
    for group, root, _ in roots():
        print(f'  {group:<14} {root}{"" if real(root).is_dir() else "  (missing)"}')
    return 0


def cmd_show(skills, args):
    if len(args) not in (1, 2) or (len(args) == 2 and not args[1].isdigit() and args[1] != '--all'):
        return usage()
    skill, error = pick(skills, args[0])
    if not skill:
        print(error, file=sys.stderr)
        return 1
    notes = lane_notes(skill)
    head = [f"SKILL {skill['name']} ({skill['group']}, {skill['kind']})", f"File: {skill['file']}", '',
            'LANE NOTES (read these first: they turn the skill\'s tool names into this client\'s commands)']
    head += ['- ' + n for n in notes] or ['- none']
    whole = '\n'.join(head) + '\n\nTHE SKILL\n' + skill['text'].rstrip('\n') + '\n'
    if len(args) == 2 and args[1] == '--all':
        sys.stdout.write(whole)
        return 0
    parts = [whole[i:i + PART] for i in range(0, len(whole), PART)] or ['']
    number = int(args[1]) if len(args) == 2 else 1
    if not 1 <= number <= len(parts):
        print(f"{skill['name']} has {len(parts)} part(s).", file=sys.stderr)
        return 1
    if len(parts) > 1:
        print(f"[part {number} of {len(parts)}" + (f"; next: skill show {skill['name']} {number + 1}]" if number < len(parts) else ']'))
    sys.stdout.write(parts[number - 1])
    if not parts[number - 1].endswith('\n'):
        sys.stdout.write('\n')
    if number < len(parts):
        print(f"[continues: skill show {skill['name']} {number + 1}]")
    return 0


RUN = {'.py': 'deb python3', '.js': 'deb node', '.cjs': 'deb node', '.mjs': 'deb node', '.sh': 'deb bash', '.ts': 'deb npx tsx'}


def cmd_files(skills, args):
    if len(args) != 1:
        return usage()
    skill, error = pick(skills, args[0])
    if not skill:
        print(error, file=sys.stderr)
        return 1
    if skill['kind'] != 'skill':
        print(f"{skill['name']} is a single command file: {skill['file']}")
        return 0
    base = skill['real_folder']
    files = sorted(p for p in base.rglob('*') if p.is_file() and not any(part in SKIP_DIRS for part in p.relative_to(base).parts))
    files = [p for p in files if p.name != '__init__.py' and not p.name.upper().startswith('LICENSE') and p != base / 'SKILL.md']
    groups, single = {}, []
    for p in files:
        rel = p.relative_to(base)
        library = next((q for q in rel.parents if q != Path('.') and q.parts[:1] != ('.',) and
                        ('schemas' in q.parts or (base / q / '__init__.py').is_file() and len(q.parts) > 1)), None)
        if library is not None:
            top = Path(*library.parts[:library.parts.index('schemas') + 1]) if 'schemas' in library.parts else library
            groups.setdefault(top, []).append(p)
        else:
            single.append(p)
    print(f"Folder: {skill['folder']}")
    if not files:
        print('  (only SKILL.md)')
        return 0
    print(f"Run a script: deb python3 {skill['folder']}/PATH (.js: deb node, .sh: deb bash). "
          f"Read a file: deb sed -n '1,120p' {skill['folder']}/PATH")
    for p in single:
        how = 'run' if p.suffix in RUN else 'read'
        print(f'  {how:<4} {p.relative_to(base)}  ({p.stat().st_size} bytes)')
    for top, items in groups.items():
        kinds = {}
        for p in items:
            kinds[p.suffix or '(none)'] = kinds.get(p.suffix or '(none)', 0) + 1
        print(f'  lib  {top}/  ({len(items)} files the scripts use: ' + ', '.join(f'{k} {v}' for k, v in sorted(kinds.items())) + ')')
    return 0


def words_of(query):
    out = []
    for w in re.findall(r'[a-z0-9+.-]+', query.lower()):
        if len(w) < 3 and w not in ('ai', 'ui', 'ux', 'qa'):
            continue
        out.append(w[:-1] if len(w) > 4 and w.endswith('s') else w)
        out.extend(SYNONYMS.get(w, '').split())
    return list(dict.fromkeys(out))


def cmd_find(skills, args):
    if not args:
        return usage()
    words = words_of(' '.join(args))
    if not words:
        return usage()
    scored = []
    for s in skills:
        name, desc, body = s['name'].lower(), s['description'].lower(), s['text'].lower()
        score = 0
        for w in words:
            score += 6 * (w in name) + 3 * (w in desc) + min(body.count(w), 5) * 0.2
        if s['group'] == 'claude':
            score *= 1.3
        elif s['group'] == 'claude-plugin':
            score *= 1.15
        if score >= 1:
            scored.append((score, s))
    scored.sort(key=lambda item: -item[0])
    if not scored:
        print('No skill matches: ' + ' '.join(args), file=sys.stderr)
        return 1
    for _, s in scored[:10]:
        print(f"{s['name']:<44} {purpose(s['description']) or '(no description)'}")
    print('Print one with: skill show NAME')
    return 0


def usage():
    print(__doc__.strip().split('\n\n')[1], file=sys.stderr)
    return 2


def main(argv):
    verbs = {'list': cmd_list, 'show': cmd_show, 'files': cmd_files, 'find': cmd_find, 'groups': cmd_groups}
    if len(argv) < 2 or argv[1] not in verbs:
        return usage()
    return verbs[argv[1]](scan(), argv[2:])


if __name__ == '__main__':
    raise SystemExit(main(sys.argv))
