    ('grok', HOME + '/.grok/bundled/skills', 'grok:'),
    ('agy', '/root/.gemini/antigravity-cli/builtin/skills', 'agy:'),
    ('library', '/usr/local/lib/python3.13/dist-packages/modal/skills', 'modal:'),
    ('library', '/usr/local/lib/python3.13/dist-packages/playwright/driver/package/lib/tools/skills', 'playwright:'),
    ('library', '/root/.mobilerun-venv/lib/python3.13/site-packages/fastapi/.agents/skills', 'fastapi:'),
    ('library', '/root/.mobilerun-venv/lib/python3.13/site-packages/pydantic_ai/.agents/skills', 'pydantic-ai:'),
    ('library', '/root/.mobilerun-venv/lib/python3.13/site-packages/phoenix/server/agents/prompts/skills', 'phoenix:'),
    ('library', '/root/wimline/nvenv/lib/python3.13/site-packages/typer/.agents/skills', 'typer:'),
]
GROUP_WORDS = {
    'claude': "George's Claude Code skills (installed)",
    'claude-plugin': "skills of the plugins installed in George's Claude Code",
    'codex': "George's Codex skills",
    'codex-plugin': "skills of the plugins installed in George's Codex",
    'marketplace': 'skills of plugins in the downloaded plugin catalogs (on disk, not installed)',
    'grok': "skills that ship with the grok program",
    'agy': "skills that ship with Google's Antigravity CLI",
    'library': 'skills that ship inside installed Python packages (modal, playwright, fastapi, pydantic-ai, phoenix, typer)',
    'project': "skills inside George's own project folders",
}
SKIP_DIRS = {'node_modules', '.git', '__pycache__', '.venv', 'venv'}
SYNONYMS = {'excel': 'xlsx spreadsheet', 'spreadsheets': 'xlsx spreadsheet', 'sheet': 'xlsx spreadsheet',
            'word': 'docx', 'powerpoint': 'pptx', 'slides': 'pptx slide deck', 'deck': 'pptx slide',
            'review': 'review', 'research': 'research', 'chart': 'chart visualization', 'scrape': 'scrape scraping'}


def real(path):
    """The place of a Debian-side path as this process sees it."""
    if path.startswith(HOME) or path.startswith('/sdcard') or path.startswith('/storage') or not ROOTFS:
        return Path(path)
    return Path(ROOTFS + path)


def roots():
    custom = os.environ.get('SKILL_ROOTS')
    if not custom:
        return DEFAULT_ROOTS
    out = []
    for item in custom.split(';'):
        group, folder, *prefix = item.split('|')
        out.append((group, folder, prefix[0] if prefix else ''))
    return out


def frontmatter(text):
    """name, description and allowed-tools from the YAML block at the top. Handles quotes and | > blocks."""
    meta = {}
    if not text.startswith('---'):
        return meta
    end = text.find('\n---', 3)
    if end < 0:
        return meta
    lines = text[3:end].splitlines()
    i = 0
    while i < len(lines):
        m = re.match(r'^([A-Za-z_-]+):\s*(.*)$', lines[i])
        i += 1
        if not m:
            continue
        key, value = m.group(1), m.group(2).strip()
        if value in ('|', '>', '|-', '>-', '>+', '|+') or value == '':
            block = []
            while i < len(lines) and (lines[i].startswith((' ', '\t')) or not lines[i].strip()):
                block.append(lines[i].strip())
                i += 1
            value = ' '.join(part for part in block if part)
        elif len(value) >= 2 and value[0] == value[-1] and value[0] in '"\'':
            value = value[1:-1].replace('\\"', '"')
        meta[key.lower()] = value
    return meta


def plugin_name(start, stop):
    """The name of the plugin that holds folder `start`, looking upward no higher than `stop`."""
    here = start
    while True:
        for candidate in (here / '.claude-plugin' / 'plugin.json', here / '.codex-plugin' / 'plugin.json', here / 'plugin.json'):
            if candidate.is_file():
                try:
                    return json.loads(candidate.read_text(encoding='utf-8')).get('name') or here.name
                except (ValueError, OSError):
                    return here.name
        if here == stop or here.parent == here:
            break
        here = here.parent
    # A plugin folder without plugin.json: PLUGIN/skills/SKILL_FOLDER or PLUGIN/commands/FILE.
    if start.parent.name in ('skills', 'commands') and start.parent != stop and start.parent.parent != stop.parent:
        return start.parent.parent.name
    if start.name == 'commands' and start != stop:
        return start.parent.name
    return None


def debian_path(found, root_real, root):
    return root + str(found)[len(str(root_real)):]


def purpose(description):
    text = ' '.join(description.split())
    cut = re.split(r'(?<=[.!?])\s', text, maxsplit=1)[0]
    return cut if len(cut) <= 140 else cut[:137].rstrip() + '...'


def scan():
    skills, seen = [], set()
    for group, root, prefix in roots():
        top = real(root)
        if not top.is_dir():
            continue
        found = []
        for folder, dirs, files in os.walk(top):
            dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS)
            if 'SKILL.md' in files:
                found.append((Path(folder), Path(folder) / 'SKILL.md', 'skill'))
            if Path(folder).name == 'commands' and group in ('claude-plugin', 'codex-plugin', 'project'):
                found.extend((Path(folder), Path(folder) / f, 'command') for f in sorted(files) if f.endswith('.md'))
        for folder, file, kind in found:
            try:
                text = file.read_text(encoding='utf-8', errors='replace')
            except OSError:
                continue
            meta = frontmatter(text)
            short = folder.name if kind == 'skill' else file.stem
            plugin = plugin_name(folder.parent if kind == 'command' else folder, top)
            name = f'{plugin}:{short}' if plugin else prefix + short
            if name in seen:
                continue
            seen.add(name)
            plugin_dir = None
            if plugin:
                probe = folder
                while probe != top and not any((probe / m).exists() for m in ('.claude-plugin', '.codex-plugin', 'plugin.json')):
                    probe = probe.parent
                plugin_dir = debian_path(probe, top, root)
            skills.append({'name': name, 'short': short, 'alias': meta.get('name', ''), 'group': group, 'kind': kind,
                           'description': meta.get('description', ''), 'allowed': meta.get('allowed-tools', ''),
                           'file': debian_path(file, top, root), 'folder': debian_path(folder, top, root),
                           'plugin_dir': plugin_dir, 'real_file': file, 'real_folder': folder, 'text': text})
    return skills


def pick(skills, name):
    exact = [s for s in skills if s['name'] == name]
    if exact:
        return exact[0], None
    loose = [s for s in skills if name in (s['short'], s['alias']) or s['name'].endswith(':' + name)]
    if len(loose) == 1:
        return loose[0], None
    if loose:
        return None, f'{len(loose)} skills are named {name}: ' + ', '.join(s['name'] for s in loose) + '. Use the full name.'
    return None, f'No skill named {name}. Run: skill find WORDS'


